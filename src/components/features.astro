---
import Link from "@components/ui/link.astro";
import { localizePath } from "astro-i18next";
// @ts-ignore
import { Icon } from "astro-icon/components";
import { t } from "i18next";

const features = [
	{
		title: "Astro",
		description: "features.astro",
		icon: "bx:bxs-briefcase",
		url: "https://astro.build/",
	},
	{
		title: "Alpine",
		description: "features.alpine",
		icon: "bx:bxs-window-alt",
		url: "https://alpinejs.dev/",
	},
	{
		title: "Tailwind",
		description: "features.tailwind",
		icon: "bx:bxs-data",
		url: "https://tailwindcss.com/",
	},
	{
		title: "Localization",
		description: "features.localization",
		icon: "bx:bxs-bot",
		url: "https://github.com/yassinedoghri/astro-i18next",
	},
	{
		title: "Light/Dark Mode",
		description: "features.light_dark_mode",
		icon: "bx:bxs-file-find",
		url: "https://tailwindcss.com/docs/dark-mode",
	},
	{
		title: "Giscus",
		description: "features.giscus",
		icon: "bx:bxs-user",
		url: "https://giscus.app/",
	},
	{
		title: "Decap CMS",
		description: "features.decapcms",
		icon: "bx:bxs-user",
		url: "https://decapcms.org/",
	},
	{
		title: "RSS feed",
		description: "features.rss",
		icon: "bx:bxs-user",
		url: "/rss.xml",
	},
	{
		title: "Article generator (soon)",
		description: "features.articlegenerator",
		icon: "bx:bxs-user",
		url: "#",
	},
];
---

<div class="relative p-8">
    <div class="max-w-7xl mx-auto">

		<h2 class="mt-6 text-2xl font-semibold tracking-tight text-gray-900 dark:text-white sm:text-2xl">{t("features.subtitle")}</h2>
		 
		<p class="mt-6 text-lg leading-8 text-gray-900 dark:text-white"><a href="https://tiktokio.cam" class="font-medium text-indigo-700 dark:text-indigo-700 hover:underline">{t("hero.tiktokio")}</a> {t("features.titlepg")}</p>
		
		<h2 class="mt-6 text-2xl font-semibold tracking-tight text-gray-900 dark:text-white sm:text-2xl">{t("features.title_mp3_down")}</h2>
		<p class="mt-6 text-lg leading-8 text-gray-900 dark:text-white">{t("features.tiktok_mp3_text1")} <a href="/tiktok-mp3" class="font-medium text-indigo-700 dark:text-indigo-700 hover:underline">{t("features.title_mp3_downloader")}</a> {t("features.tiktok_mp3_text2")}</p>

		<h2 class="mt-6 text-2xl font-semibold tracking-tight text-gray-900 dark:text-white sm:text-2xl">{t("features.title")}</h2>
		<p class="mt-6 text-lg leading-8 text-gray-900 dark:text-white">{t("features.description")} <a href="/" class="font-medium text-indigo-700 dark:text-indigo-700 hover:underline">{t("header.tvd")}</a> {t("features.descriptions")}</p>
		<p class="mt-6 text-lg leading-8 text-gray-900 dark:text-white">{t("features.description1")} <a href="https://scarlet-ios.app/pt-br/" class="font-medium text-indigo-700 dark:text-indigo-700 hover:underline">{t("features.scarlet")}</a> {t("features.description2")}</p>
	
		
		<h2 class="mt-6 text-2xl font-semibold tracking-tight text-gray-900 dark:text-white sm:text-2xl">{t("features.description_title")}</h2>
		<p class="mt-6 text-lg leading-8 text-gray-900 dark:text-white">{t("features.heading2_des1")} <a href="/" class="font-medium text-indigo-700 dark:text-indigo-700 hover:underline">{t("features.format_text_link")}</a> {t("features.heading2_des1_1")} <strong><a href="https://downloadgbwa.com/" target="_blank" class="font-medium text-indigo-700 dark:text-indigo-700 hover:underline">{t("features.text_gb")}</a> and <a href="https://waplusoficial.com/" target="_blank" class="font-medium text-indigo-700 dark:text-indigo-700 hover:underline">{t("features.text_gbplus")}</a></strong>.</p>
		<h2 class="mt-6 text-2xl font-semibold tracking-tight text-gray-900 dark:text-white sm:text-2xl">{t("features.heading2")}</h2>
		<p class="mt-6 text-lg leading-8 text-gray-900 dark:text-white">{t("features.heading2_des2")}</p>

     </div>
</div>
